{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CapitalForge",
  "version": "1.3.0",
  "identifier": "com.conforcus.capitalforge",
  "build": {
    "frontendDist": "../../web/dist-desktop",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "pnpm --filter @capital/web exec vite --mode desktop",
    "beforeBuildCommand": "pnpm --filter @capital/web build:desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CapitalForge",
        "width": 1280,
        "height": 760,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' data: blob:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Conforcus",
    "copyright": "© 2026 Conforcus",
    "category": "SimulationGame",
    "shortDescription": "Şehir ve şirket kurma oyunu",
    "longDescription": "CapitalForge: bir şehirde arsa al, dükkân aç, tedarik zincirini kur, rakiplerinle yarış. Kayıtlar bilgisayarında, oyun çevrimdışı oynanıyor; lig çevrimiçi.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
