{
  "name": "capital-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @capital/web dev",
    "build": "pnpm --filter @capital/web build",
    "preview": "pnpm --filter @capital/web preview",
    "typecheck": "tsc -p packages/content && tsc -p packages/core && tsc -p packages/persistence && tsc -p packages/render-three && tsc -p packages/ui && tsc -p apps/web",
    "test": "node --test --experimental-strip-types packages/core/test/*.test.ts",
    "balance": "node tools/run-node-script.mjs packages/core/test/balance.ts",
    "bench": "node tools/run-node-script.mjs packages/core/test/benchmark.ts",
    "playtest": "pnpm build && node tools/playtest.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
