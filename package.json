{
  "name": "capital-game",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @capital/web dev",
    "build": "pnpm --filter @capital/web build",
    "preview": "pnpm --filter @capital/web preview",
    "typecheck": "tsc -p packages/content && tsc -p packages/lite-model && tsc -p packages/lite-league && tsc -p packages/core && tsc -p packages/persistence && tsc -p packages/render-three && tsc -p packages/ui && tsc -p apps/web && tsc -p apps/lite-web",
    "test": "node tools/run-tests.mjs",
    "balance": "node tools/run-node-script.mjs packages/core/test/balance.ts",
    "lite:balance": "node tools/run-node-script.mjs packages/lite-model/test/balance.ts",
    "lite:fixtures": "node tools/run-node-script.mjs packages/lite-model/test/write-fixtures.ts",
    "lite:league-bundle": "node tools/bundle-lite-league.mjs",
    "lite:d1-sql": "node tools/run-node-script.mjs packages/lite-league/scripts/write-d1-console.ts",
    "bench": "node tools/run-node-script.mjs packages/core/test/benchmark.ts",
    "dayperf": "node tools/run-node-script.mjs packages/core/test/dayperf.ts",
    "constraint": "node tools/run-node-script.mjs packages/core/test/constraint.ts",
    "land": "node tools/run-node-script.mjs packages/core/test/land-experiment.ts",
    "longrun": "node tools/run-node-script.mjs packages/core/test/longrun.ts",
    "playtest": "pnpm build && node tools/playtest.mjs",
    "playtest:smoke": "pnpm build && node tools/playtest.mjs --smoke",
    "bundle:check": "pnpm build && node tools/bundle-check.mjs",
    "lite:web": "pnpm --filter @capital/lite-web dev",
    "lite:web-build": "pnpm --filter @capital/lite-web build",
    "lite:web-e2e": "node tools/lite-web-e2e.mjs",
    "lite:league-local": "node tools/run-node-script.mjs packages/lite-league/test/local-server.ts",
    "lite:android-sync": "pnpm --filter @capital/lite-android sync",
    "lite:android-icons": "node apps/lite-android/tools/make-icons.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
